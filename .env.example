# LLM API Keys (Optional - System works out-of-the-box in local engine mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model Configurations
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant

# Resilience & Timeouts
TOOL_TIMEOUT_SECONDS=6.0
TOOL_MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=0.5
MAX_SEARCH_RESULTS=5
MAX_SCRAPED_CHARS=4000
MIN_SOURCE_RELEVANCE_SCORE=0.45
PROMPT_INJECTION_PROTECTION=True
CACHE_TOOL_CALLS=True
ENABLE_JUDGE_STEP=True

